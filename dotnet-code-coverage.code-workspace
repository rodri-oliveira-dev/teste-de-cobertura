{
  "folders": [
    {
      "name": "dotnet-code-coverage",
      "path": "."
    }
  ],
  "settings": {
    "files.exclude": {
      "**/bin": true,
      "**/obj": true,
      "**/artifacts": true
    },
    "[csharp]": {
      "editor.formatOnSave": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-dotnettools.csdevkit",
      "redhat.vscode-yaml"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": ".NET: Restore Tools",
        "type": "process",
        "command": "dotnet",
        "args": [
          "tool",
          "restore"
        ],
        "problemMatcher": []
      },
      {
        "label": ".NET: Restore",
        "type": "process",
        "command": "dotnet",
        "args": [
          "restore",
          "DotNet.CodeCoverage.slnx"
        ],
        "problemMatcher": []
      },
      {
        "label": ".NET: Build Debug",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "DotNet.CodeCoverage.slnx",
          "--configuration",
          "Debug",
          "--no-restore"
        ],
        "dependsOn": [
          ".NET: Restore"
        ],
        "dependsOrder": "sequence",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": "$msCompile"
      },
      {
        "label": ".NET: Build Release",
        "type": "process",
        "command": "dotnet",
        "args": [
          "build",
          "DotNet.CodeCoverage.slnx",
          "--configuration",
          "Release",
          "--no-restore"
        ],
        "dependsOn": [
          ".NET: Restore"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": "$msCompile"
      },
      {
        "label": ".NET: Test",
        "group": "test",
        "problemMatcher": [],
        "dependsOn": [
          ".NET: Test Unit",
          ".NET: Test Integration"
        ],
        "dependsOrder": "sequence"
      },
      {
        "label": ".NET: Test Unit",
        "type": "process",
        "command": "dotnet",
        "args": [
          "test",
          "MaiorDeIdade.Tests/MaiorDeIdade.Tests.csproj",
          "--configuration",
          "Release"
        ],
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": ".NET: Test Integration",
        "type": "process",
        "command": "dotnet",
        "args": [
          "test",
          "MaiorDeIdade.IntegrationTests/MaiorDeIdade.IntegrationTests.csproj",
          "--configuration",
          "Release"
        ],
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": ".NET: Test E2E",
        "type": "process",
        "command": "dotnet",
        "args": [
          "test",
          "MaiorDeIdade.E2ETests/MaiorDeIdade.E2ETests.csproj",
          "--configuration",
          "Release"
        ],
        "options": {
          "env": {
            "E2E_BASE_URL": "http://127.0.0.1:5055"
          }
        },
        "group": "test",
        "problemMatcher": []
      },
      {
        "label": ".NET: Coverage Unit",
        "type": "process",
        "command": "dotnet",
        "args": [
          "test",
          "MaiorDeIdade.Tests/MaiorDeIdade.Tests.csproj",
          "--configuration",
          "Release",
          "--results-directory",
          "artifacts/test-results/unit",
          "--coverlet",
          "--coverlet-output-format",
          "cobertura"
        ],
        "problemMatcher": []
      },
      {
        "label": ".NET: Coverage Integration",
        "type": "process",
        "command": "dotnet",
        "args": [
          "test",
          "MaiorDeIdade.IntegrationTests/MaiorDeIdade.IntegrationTests.csproj",
          "--configuration",
          "Release",
          "--results-directory",
          "artifacts/test-results/integration",
          "--coverlet",
          "--coverlet-output-format",
          "cobertura"
        ],
        "problemMatcher": []
      },
      {
        "label": ".NET: Coverage",
        "dependsOn": [
          ".NET: Coverage Unit",
          ".NET: Coverage Integration"
        ],
        "dependsOrder": "sequence",
        "problemMatcher": []
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": ".NET: Debug MaiorDeIdade.Api",
        "type": "coreclr",
        "request": "launch",
        "preLaunchTask": ".NET: Build Debug",
        "program": "${workspaceFolder}/MaiorDeIdade.Api/bin/Debug/net10.0/MaiorDeIdade.Api.dll",
        "cwd": "${workspaceFolder}/MaiorDeIdade.Api",
        "stopAtEntry": false,
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5055"
        }
      }
    ]
  }
}
